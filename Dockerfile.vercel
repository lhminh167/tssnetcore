FROM mcr.microsoft.com/dotnet/sdk:3.1 AS build
WORKDIR /src

COPY src/Tss.csproj ./
RUN dotnet restore Tss.csproj

COPY src/ ./
RUN dotnet publish Tss.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:3.1
WORKDIR /app
COPY --from=build /app/publish .
EXPOSE 80
ENTRYPOINT ["sh", "-c", "dotnet Tss.dll --urls http://0.0.0.0:${PORT:-80}"]
